# Browserbase API Configuration
# Copy this file to .env and fill in your credentials

# Required: Your Browserbase API key
BROWSERBASE_API_KEY=bb_live_xxxxxxxxxxxx

# Required: Your Browserbase project ID
BROWSERBASE_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Default URL to open on startup (defaults to https://www.google.com)
BROWSERBASE_DEFAULT_URL=https://www.google.com

# Optional: Route traffic through Browserbase's managed proxy network
BROWSERBASE_PROXY_ENABLED=false

# Optional: Enable Verified Browser Mode (requires a supported plan)
BROWSERBASE_VERIFIED=false

# Optional: Explicitly enable or disable Browserbase CAPTCHA solving
BROWSERBASE_SOLVE_CAPTCHAS=true
