# Browserbase API Configuration
# Copy this file to .env and fill in your credentials

# Required: Your Browserbase API key
BROWSERBASE_API_KEY=bb_live_xxxxxxxxxxxx

# Optional: Default URL to open on startup (defaults to https://www.google.com)
BROWSERBASE_DEFAULT_URL=https://www.google.com

# Optional: Verified Browser Mode (default true, Scale plan). Set false to opt out.
# If the API key cannot use it, the app retries without it and logs an AGENT NOTICE.
# BROWSERBASE_VERIFIED=false

# Optional: Managed proxies (default true, paid plan). Set false to opt out.
# If the API key cannot use them, the app retries without them and logs an AGENT NOTICE.
# BROWSERBASE_PROXIES=false
